# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA — SAÚDELAB EXAMES (TRIAGEM WHATSAPP 24H)
# ==============================================================================

# CREDENCIAIS DE ACESSO AO PAINEL WEB (PARA A DONA DA SAÚDELAB ESCANEAR QR CODE E VER LOGS)
PANEL_USER=saudelab
PANEL_PASS= ChangeMe_DefinaNoArquivoEnvLocal
PANEL_SECRET=saudelab-session-secret-key-2026

# MODO DE HOMOLOGAÇÃO / PRODUÇÃO:
# TEST_MODE=true  -> Só inicia triagem para quem mandar a palavra TRIGGER_WORD (#saudelab)
# TEST_MODE=false -> Atende automaticamente qualquer cliente que mandar mensagem
TEST_MODE=true
TRIGGER_WORD=#saudelab

# REGRA DE OCIOSIDADE (5 MINUTOS E ATÉ 2 TENTATIVAS):
INACTIVITY_MINUTES=5
MAX_FOLLOWUPS=2

# PORTAS DO SISTEMA
PORT=5006
BOT_ENGINE_PORT=5007
