# ==============================================================================
# SAÚDELAB EXAMES — CONFIGURAÇÃO DO BOT DE TRIAGEM 24H E PAINEL WEB (v4.3.0)
# ==============================================================================

# Modo de Operação:
# true  = Modo Teste/Homologação (só ativa o bot quando alguém envia a TRIGGER_WORD)
# false = Modo Produção 24h (ativa o bot para qualquer mensagem recebida de clientes)
TEST_MODE=true
TRIGGER_WORD=#saudelab

# Controle de Ociosidade (5 minutos por tentativa, até 2 avisos antes de encerrar)
INACTIVITY_MINUTES=5
MAX_FOLLOWUPS=2

# Pausa automática quando uma atendente humana assume a conversa (em minutos)
HUMAN_PAUSE_MINUTES=60

# Portas de Rede
STATUS_PORT=5006
BOT_ENGINE_PORT=5007

# Credenciais de Acesso ao Painel Web / QR Code / Logs
PANEL_USER=saudelab
PANEL_PASS=ALTERE_ESTA_SENHA
PANEL_SECRET=saudelab-session-secret-2026
